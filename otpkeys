// =================== COMMANDS ===================
cmd = ""
if params.len > 0 then cmd = params[0]
alias = {"g":"gen","n":"next","s":"status","w":"watch","h":"help","d":"doctor","l":"lockdown"}
if alias.hasIndex(cmd) then cmd = alias[cmd]

if cmd == "" or cmd == "help" then
  showHelp

else if cmd == "setup" then
  if fileExists(KEYFILE) then exit("Already set up. Use: otpkeys gen")
  pinH = askNewPin
  nIn = user_input("How many keys? (default 20): ")
  n = 20
  if nIn != "" then n = nIn.val
  if n < 1 then n = 20
  t = nowMin
  S = {"pin": pinH, "cfg": {} + DEFAULTS, "keys": []}
  for i in range(1, n)
    S.keys.push(newEntry(t))
  end for
  S.keys[0].act = t
  save
  applyHead
  audit("setup, " + n + " keys")
  reveal("Your one-time keys:", S.keys)
  print("Done. Next: otpkeys doctor, then otpkeys watch")

else if cmd == "doctor" then
  print("Shards:")
  missing = shardReport
  print("Clock: '" + current_date + "' parsed as minute " + nowMin)
  print("  (log in twice a few minutes apart and check this number rises by the right amount)")
  if missing > 0 then exit("Fix the missing shards first.")
  if not fileExists(KEYFILE) then exit("No key file. Run: otpkeys setup")
  S = loadState
  print("Key file: OK, " + S.keys.len + " keys, checksum valid")
  if fileExists(S.cfg.logfile) then
    print("Log file: OK (" + S.cfg.logfile + ")")
  else
    print("Log file: NOT FOUND (" + S.cfg.logfile + "). Fix: otpkeys set logfile <path>")
  end if
  if S.cfg.lockdown == 1 then print("LOCKDOWN is active.")
  if S.keys.len <= S.cfg.low then print("WARNING: only " + S.keys.len + " keys left. Run: otpkeys add")

else
  if not fileExists(KEYFILE) then exit("Not set up yet. Run: otpkeys setup")
  S = loadState

  if cmd == "gen" then
    auth
    if S.keys.len > 0 then
      ok = user_input("This replaces " + S.keys.len + " unused keys. Continue? (y/n): ")
      if ok != "y" then exit("Cancelled.")
    end if
    n = 20
    if params.len > 1 then n = params[1].val
    if n < 1 then n = 20
    t = nowMin
    S.keys = []
    for i in range(1, n)
      S.keys.push(newEntry(t))
    end for
    S.keys[0].act = t
    S.cfg.hits = 0
    save
    applyHead
    audit("gen " + n + " keys")
    reveal(n + " new one-time keys:", S.keys)

  else if cmd == "add" then
    auth
    n = 10
    if params.len > 1 then n = params[1].val
    if n < 1 then n = 10
    t = nowMin
    fresh = []
    for i in range(1, n)
      fresh.push(newEntry(t))
    end for
    S.keys = S.keys + fresh
    save
    tick
    audit("added " + n + " keys")
    reveal("Added " + n + " keys:", fresh)

  else if cmd == "now" then
    auth
    tick
    if S.keys.len == 0 then exit("No keys left.")
    e = S.keys[0]
    print("Active key: " + e.k)
    print(lifeLeft(e, nowMin) + " min left, uses " + e.uses + "/" + S.cfg.uses + ", strikes " + e.strikes + "/" + S.cfg.strikes)
    user_input("Press Enter to clear the screen...")
    clear_screen

  else if cmd == "next" then
    auth
    if S.keys.len == 0 then exit("No keys left.")
    S.keys[0].uses = S.cfg.uses
    tick
    print("Rotated. " + S.keys.len + " keys left.")

  else if cmd == "extend" then
    auth
    mins = 10
    if params.len > 1 then mins = params[1].val
    if S.keys.len == 0 then exit("No keys left.")
    S.keys[0].act = S.keys[0].act + mins
    save
    audit("extended active key by " + mins + " min")
    print("Extended by " + mins + " min.")

  else if cmd == "status" then
    print("Shards:")
    shardReport
    tick
    t = nowMin
    if S.cfg.lockdown == 1 then print("*** LOCKDOWN ACTIVE ***")
    print("Keys left: " + S.keys.len)
    if S.keys.len <= S.cfg.low then print("WARNING: running low. Run: otpkeys add")
    if S.keys.len > 0 then
      for i in range(0, S.keys.len - 1)
        e = S.keys[i]
        if i == 0 then
          print("  ACTIVE  " + e.k[:2] + "***  " + lifeLeft(e, t) + " min left, uses " + e.uses + "/" + S.cfg.uses + ", strikes " + e.strikes)
        else
          print("  queued  " + e.k[:2] + "***  stale in " + (S.cfg.shelf - (t - e.issued)) + " min")
        end if
      end for
    end if

  else if cmd == "lockdown" then
    doLockdown("manual")

  else if cmd == "open" then
    auth(true)
    S.cfg.lockdown = 0
    S.cfg.hits = 0
    S.cfg.bad = 0
    if S.keys.len > 0 then S.keys[0].act = nowMin
    applyHead
    save
    audit("lockdown lifted")
    print("Lockdown lifted. " + S.keys.len + " keys available.")
    if S.keys.len == 0 then print("No keys left. Run: otpkeys gen")

  else if cmd == "pin" then
    auth
    S.pin = askNewPin
    save
    audit("PIN changed")
    print("PIN changed.")

  else if cmd == "set" then
    auth
    if params.len < 3 then
      for kv in S.cfg
        if HIDDEN.indexOf(kv.key) == null then print("  " + kv.key + " = " + kv.value)
      end for
      print("Usage: otpkeys set <name> <value>")
    else
      name = params[1]
      newVal = params[2:].join(" ")
      if not DEFAULTS.hasIndex(name) or HIDDEN.indexOf(name) != null then exit("Unknown setting: " + name)
      if newVal.indexOf("|") != null or newVal.indexOf(";") != null then exit("Value can't contain | or ;")
      if DEFAULTS[name] isa number then
        num = newVal.val
        if str(num) != newVal then exit(name + " needs a number.")
        S.cfg[name] = num
      else
        S.cfg[name] = newVal
      end if
      save
      audit("setting changed: " + name + " = " + newVal)
      print(name + " = " + newVal)
      if name == "user" then print("Note: the old account keeps its last password. Lock it down by hand.")
    end if

  else if cmd == "learn" then
    lf = pc.File(S.cfg.logfile)
    if lf == null then exit("Log not found: " + S.cfg.logfile + "  (otpkeys set logfile <path>)")
    lines = tail(lf.get_content.split(char(10)), 8)
    print("Last log lines:")
    print(lines.join(char(10)))
    print("")
    print("Log in once (and fail once), run this again, then:")
    print("  otpkeys set login <text only in a good login line>")
    print("  otpkeys set fail <text only in a failed attempt>")

  else if cmd == "history" then
    n = 15
    if params.len > 1 then n = params[1].val
    if not fileExists(LOGFILE) then exit("No history yet.")
    lines = tail(pc.File(LOGFILE).get_content.split(char(10)), n)
    print(lines.join(char(10)))

  else if cmd == "watch" then
    auth
    print("Watching " + S.cfg.logfile + ". Ctrl+C to stop.")
    lf = pc.File(S.cfg.logfile)
    if lf == null then exit("Log not found. Run: otpkeys learn")
    lastLen = lf.get_content.split(char(10)).len
    warned = false
    while true
      wait(3)
      S = loadState
      if S.cfg.lockdown == 1 then exit("Lockdown active. Watch stopped.")
      lf = pc.File(S.cfg.logfile)
      if lf != null then
        lines = lf.get_content.split(char(10))
        if lines.len < lastLen then lastLen = 0
        if lines.len > lastLen then
          fresh = lines[lastLen:]
          lastLen = lines.len
          dirty = false
          for ln in fresh
            if S.keys.len > 0 then
              low = ln.lower
              if low.indexOf(S.cfg.fail.lower) != null then
                S.keys[0].strikes = S.keys[0].strikes + 1
                S.cfg.hits = S.cfg.hits + 1
                audit("strike: " + ln[:80])
                print("Strike " + S.keys[0].strikes + "/" + S.cfg.strikes)
                dirty = true
              else if low.indexOf(S.cfg.login.lower) != null then
                S.keys[0].uses = S.keys[0].uses + 1
                S.cfg.hits = 0
                audit("login: " + ln[:80])
                print("Login detected.")
                dirty = true
              end if
            end if
          end for
          if dirty then
            save
            if S.cfg.hits >= S.cfg.lockHits then
              doLockdown("brute force (" + S.cfg.hits + " failures in a row)")
              exit("Watch stopped.")
            end if
          end if
        end if
      end if
      tick
      if S.keys.len == 0 then exit("Out of keys. Account locked. Run: otpkeys gen")
      if S.keys.len <= S.cfg.low and not warned then
        print("WARNING: only " + S.keys.len + " keys left.")
        warned = true
      end if
      if S.keys.len > S.cfg.low then warned = false
    end while

  else if cmd == "panic" then
    auth(true)
    yes = user_input("Wipe all keys and shards? (type YES): ")
    if yes == "YES" then
      pc.change_password(S.cfg.user, bytesToHex(randBytes(12)))
      audit("PANIC: wiped")
      pc.File(KEYFILE).delete
      for i in range(0, 2)
        p = SHARD_DIRS[i] + "/" + SHARD_NAMES[i]
        if fileExists(p) then pc.File(p).delete
      end for
      print("Wiped. Account locked.")
    else
      print("Cancelled.")
    end if

  else
    print("Unknown command. Try: otpkeys help")
  end if
end if
