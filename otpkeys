DEFAULTS = {"user":"guest","ttl":30,"idle":10,"shelf":1440,"uses":1,"strikes":3,"pinTries":3,"lockHits":6,"low":3,"logfile":"/var/system.log","login":"guest","fail":"failed","lockdown":0,"bad":0,"hits":0}
