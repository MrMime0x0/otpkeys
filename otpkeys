// ---------- safe helpers (split() is regex in Greyscript) ----------
splitOn = function(s, d)
  out = []
  while true
    i = s.indexOf(d)
    if i == null then break
    out.push(s[:i])
    s = s[i + d.len:]
  end while
  out.push(s)
  return out
end function

tail = function(lines, n)
  if lines.len <= n then return lines
  return lines[lines.len - n:]
end function

// ---------- clock ----------
nowMin = function()
  nums = []
  cur = ""
  for ch in current_date
    if ch >= "0" and ch <= "9" then
      cur = cur + ch
    else
      if cur != "" then nums.push(cur.val)
      cur = ""
    end if
  end for
  if cur != "" then nums.push(cur.val)
  if nums.len < 5 then return floor(time / 60)
  cum = [0,31,59,90,120,151,181,212,243,273,304,334]
  // assumes order: day, month, year, hour, minute
  days = nums[2] * 365 + cum[(nums[1] - 1) % 12] + nums[0]
  return days * 1440 + nums[3] * 60 + nums[4]
end function

// ---------- crypto helpers ----------
toHex = function(n)
  return hex[floor(n / 16)] + hex[n % 16]
end function

bytesToHex = function(list)
  s = ""
  for b in list
    s = s + toHex(b)
  end for
  return s
end function

hexToBytes = function(h)
  list = []
  if h.len < 2 then return list
  for i in range(0, floor(h.len / 2) - 1)
    list.push(hex.indexOf(h[i*2]) * 16 + hex.indexOf(h[i*2+1]))
  end for
  return list
end function

randBytes = function(n)
  list = []
  for i in range(1, n)
    list.push(floor(rnd * 256))
  end for
  return list
end function

xor = function(a, b)
  return bitwise("^", a, b)
end function

enc = function(text, keyBytes)
  s = ""
  if text.len == 0 then return s
  for i in range(0, text.len - 1)
    s = s + toHex(xor(text[i].code, keyBytes[i % keyBytes.len]))
  end for
  return s
end function

dec = function(h, keyBytes)
  data = hexToBytes(h)
  s = ""
  if data.len == 0 then return s
  for i in range(0, data.len - 1)
    s = s + char(xor(data[i], keyBytes[i % keyBytes.len]))
  end for
  return s
end function

// simple checksum/hash (fine for a game, not real-world crypto)
hash = function(s)
  h = 5381
  for ch in s
    h = (h * 33 + ch.code) % 4294967296
  end for
  return h
end function

pinSalt = function(p)
  return "otp:" + p + ":" + p.len
end function

// ---------- files ----------
fileExists = function(path)
  return pc.File(path) != null
end function

writeFile = function(folder, name, content)
  if pc.File(folder) == null then
    cut = folder.lastIndexOf("/")
    parent = folder[:cut]
    if parent == "" then parent = "/"
    pc.create_folder(parent, folder[cut + 1:])
  end if
  if pc.File(folder + "/" + name) == null then pc.touch(folder, name)
  pc.File(folder + "/" + name).set_content(content)
end function

readFile = function(path)
  f = pc.File(path)
  if f == null then exit("Missing file: " + path)
  return f.get_content
end function

// ---------- audit log (last 200 lines) ----------
audit = function(msg)
  old = ""
  if fileExists(LOGFILE) then
    old = pc.File(LOGFILE).get_content
  else
    pc.touch(home_dir, "audit.log")
  end if
  lines = []
  if old != "" then lines = old.split(char(10))
  lines.push(current_date + "  " + msg)
  lines = tail(lines, 200)
  pc.File(LOGFILE).set_content(lines.join(char(10)))
end function

// ---------- shards: M = A ^ B ^ C ----------
makeShards = function()
  master = randBytes(16)
  a = randBytes(16)
  b = randBytes(16)
  c = []
  for i in range(0, 15)
    c.push(xor(xor(master[i], a[i]), b[i]))
  end for
  writeFile(SHARD_DIRS[0], SHARD_NAMES[0], bytesToHex(a))
  writeFile(SHARD_DIRS[1], SHARD_NAMES[1], bytesToHex(b))
  writeFile(SHARD_DIRS[2], SHARD_NAMES[2], bytesToHex(c))
  return master
end function

readMaster = function()
  parts = []
  for i in range(0, 2)
    p = SHARD_DIRS[i] + "/" + SHARD_NAMES[i]
    if not fileExists(p) then exit("Shard " + (i + 1) + " is missing: " + p)
    bytes = hexToBytes(readFile(p))
    if bytes.len != 16 then exit("Shard " + (i + 1) + " is damaged: " + p)
    parts.push(bytes)
  end for
  master = []
  for i in range(0, 15)
    master.push(xor(xor(parts[0][i], parts[1][i]), parts[2][i]))
  end for
  return master
end function

// ---------- settings stored inside the encrypted file ----------
cfgString = function(c)
  parts = []
  for kv in c
    parts.push(kv.key + "=" + kv.value)
  end for
  return parts.join(";")
end function

parseCfg = function(s)
  c = {} + DEFAULTS
  if s != "" then
    for pair in splitOn(s, ";")
      i = pair.indexOf("=")
      if i != null then
        k = pair[:i]
        v = pair[i + 1:]
        if DEFAULTS.hasIndex(k) then
          if DEFAULTS[k] isa number then c[k] = v.val else c[k] = v
        end if
      end if
    end for
  end if
  return c
end function

// ---------- keys ----------
randKey = function()
  chars = "abcdefghjkmnpqrstuvwxyz23456789"
  k = ""
  for i in range(1, 10)
    if i == 6 then k = k + "-"
    k = k + chars[floor(rnd * chars.len)]
  end for
  return k
end function

newEntry = function(t)
  return {"k": randKey, "issued": t, "act": 0, "uses": 0, "strikes": 0}
end function

serialize = function(list)
  parts = []
  for e in list
    parts.push(e.k + ":" + e.issued + ":" + e.act + ":" + e.uses + ":" + e.strikes)
  end for
  return parts.join(",")
end function

parse = function(body)
  list = []
  if body == "" then return list
  for p in splitOn(body, ",")
    f = splitOn(p, ":")
    if f.len >= 5 then
      list.push({"k": f[0], "issued": f[1].val, "act": f[2].val, "uses": f[3].val, "strikes": f[4].val})
    end if
  end for
  return list
end function

// ---------- save / load (checksum detects tampering) ----------
save = function()
  master = makeShards
  body = S.pin + "|" + cfgString(S.cfg) + "|" + serialize(S.keys)
  text = "OTP:" + hash(body) + "|" + body
  if not fileExists(KEYFILE) then pc.touch(home_dir, "keys.dat")
  pc.File(KEYFILE).set_content(enc(text, master))
end function

loadState = function()
  text = dec(readFile(KEYFILE), readMaster)
  if text[:4] != "OTP:" then exit("Shards wrong, missing, or file replaced. Access denied.")
  rest = text[4:]
  i = rest.indexOf("|")
  if i == null then exit("Key file corrupted. Delete keys.dat and shards, then run: otpkeys setup")
  body = rest[i + 1:]
  if hash(body) != rest[:i].val then exit("Key file was modified. Run: otpkeys doctor")
  p = splitOn(body, "|")
  while p.len < 3
    p.push("")
  end while
  return {"pin": p[0].val, "cfg": parseCfg(p[1]), "keys": parse(p[2])}
end function

// ---------- THE EXPIRY ALGORITHM ----------
ttlFor = function(e)
  t = floor(S.cfg.ttl / (1 + e.strikes))
  if t < 3 then t = 3
  return t
end function

expiredReason = function(e, t)
  c = S.cfg
  if e.uses >= c.uses then return "used"
  if e.strikes >= c.strikes then return "strikes"
  if e.act > 0 then
    age = t - e.act
    if age > ttlFor(e) then return "ttl"
    if e.uses == 0 and age > c.idle then return "idle"
  else
    if t - e.issued > c.shelf then return "stale"
  end if
  return ""
end function

lifeLeft = function(e, t)
  left = ttlFor(e) - (t - e.act)
  if e.uses == 0 then
    idleLeft = S.cfg.idle - (t - e.act)
    if idleLeft < left then left = idleLeft
  end if
  return left
end function

sweep = function(list, t)
  changed = false
  out = []
  for e in list
    r = expiredReason(e, t)
    if r != "" then
      audit("burned: " + r + " (uses " + e.uses + ", strikes " + e.strikes + ")")
      changed = true
    else
      out.push(e)
    end if
  end for
  if out.len > 0 and out[0].act == 0 then
    out[0].act = t
    changed = true
  end if
  return {"list": out, "changed": changed}
end function

applyHead = function()
  if S.keys.len > 0 then
    pc.change_password(S.cfg.user, S.keys[0].k)
  else
    pc.change_password(S.cfg.user, bytesToHex(randBytes(12)))
  end if
end function

tick = function()
  if S.cfg.lockdown == 1 then return
  r = sweep(S.keys, nowMin)
  S.keys = r.list
  if r.changed then
    applyHead
    save
  end if
end function

// ---------- security ----------
doLockdown = function(reason)
  S.cfg.lockdown = 1
  pc.change_password(S.cfg.user, bytesToHex(randBytes(12)))
  audit("LOCKDOWN: " + reason)
  save
  print("LOCKDOWN: account locked. Run 'otpkeys open' (needs PIN) to lift it.")
end function

auth = function(allowLocked = false)
  if S.cfg.lockdown == 1 and not allowLocked then exit("LOCKDOWN active. Run: otpkeys open")
  pin = user_input("PIN: ", true)
  if hash(pinSalt(pin)) == S.pin then
    if S.cfg.bad > 0 then
      S.cfg.bad = 0
      save
    end if
    return true
  end if
  S.cfg.bad = S.cfg.bad + 1
  audit("wrong PIN (" + S.cfg.bad + "/" + S.cfg.pinTries + ")")
  if S.cfg.bad >= S.cfg.pinTries then
    doLockdown("too many wrong PINs")
  else
    save
  end if
  exit("Wrong PIN.")
end function

askNewPin = function()
  a = user_input("Choose admin PIN (4+ chars): ", true)
  if a.len < 4 then exit("PIN too short.")
  b = user_input("Repeat PIN: ", true)
  if a != b then exit("PINs don't match.")
  return hash(pinSalt(a))
end function

// ---------- ease of use ----------
reveal = function(title, entries)
  print(title)
  if entries.len > 0 then
    for i in range(0, entries.len - 1)
      print("  " + (i + 1) + ": " + entries[i].k)
    end for
  end if
  user_input("Write them down, then press Enter to clear the screen...")
  clear_screen
end function

shardReport = function()
  missing = 0
  for i in range(0, 2)
    p = SHARD_DIRS[i] + "/" + SHARD_NAMES[i]
    if fileExists(p) then
      print("  OK       " + p)
    else
      print("  MISSING  " + p)
      missing = missing + 1
    end if
  end for
  return missing
end function

